#!/usr/bin/env bash
# Reject any AI attribution in commit messages. Authorship is 0xkinno only.
msg_file="$1"
if grep -Eiq '^\s*(co-authored-by:.*(claude|anthropic)|claude-session:|.*generated with.*claude code)' "$msg_file"; then
  sed -i -E '/^\s*[Cc]o-[Aa]uthored-[Bb]y:.*([Cc]laude|[Aa]nthropic)/d; /^\s*[Cc]laude-[Ss]ession:/d; /[Gg]enerated with.*[Cc]laude [Cc]ode/d' "$msg_file"
fi
author="$(git var GIT_AUTHOR_IDENT)"
if echo "$author" | grep -Eiq 'claude|anthropic'; then
  echo "Blocked: author identity must be 0xkinno." >&2; exit 1
fi
exit 0
